<Window x:Class="Soundboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Soundboard" Height="260" Width="480">
    <StackPanel Margin="16">
        <TextBlock Text="Output device" Margin="0,0,0,4"/>
        <ComboBox x:Name="DeviceBox" Margin="0,0,0,16"/>

        <Button x:Name="PickButton" Content="Choose clip..."
                Click="PickClip_Click" Height="32" Margin="0,0,0,8"/>
        <TextBlock x:Name="ClipLabel" Text="(no clip loaded)"
                   Foreground="Gray" Margin="0,0,0,16"/>

        <Button x:Name="PlayButton" Content="PLAY"
                Click="Play_Click" Height="48" FontSize="18"/>
    </StackPanel>
</Window>